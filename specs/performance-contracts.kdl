// Embeddenator Performance Contracts & SLA Specifications
// =========================================================
//
// This file defines formal Service Level Agreements (SLAs) for the embeddenator
// ecosystem. These are REALISTIC but DEMANDING targets that ensure production
// readiness. All targets are based on measured baselines from:
//
// - Native filesystem operations (ext4, XFS)
// - Industry-standard compression benchmarks
// - Academic VSA implementation papers
// - Real-world VM filesystem characteristics
//
// Measurement methodology:
// - All benchmarks run on warm cache (second run)
// - Intel Xeon or AMD EPYC server-class CPUs
// - NVMe SSD storage with >3GB/s sequential read
// - Criterion.rs with 100+ sample minimum
//
// Terminology:
// - p50: 50th percentile (median)
// - p99: 99th percentile (tail latency)
// - target: Expected performance (green)
// - threshold: Acceptable minimum (yellow)
// - violation: Unacceptable performance (red, fails CI)

// =============================================================================
// SECTION 1: INGEST PERFORMANCE
// =============================================================================
// Ingest = reading source files + VSA encoding + compression + storage
// This is the primary user-facing operation for encoding VMs

ingest-performance {
    // Small files (< 64KB) - common for configs, scripts, small binaries
    // Baseline: ext4 write ~200K files/sec, tar ~50K files/sec
    small-file-throughput {
        description "Files under 64KB each"
        metric "files_per_second"
        target 30000       // 30K files/sec - competitive with tar
        threshold 15000    // 15K files/sec - minimum acceptable
        violation 5000     // Below 5K/sec = architectural issue
        notes "Limited by metadata operations, not VSA encoding"
    }

    // Medium files (64KB - 10MB) - libraries, small executables
    // Baseline: zstd at level 3 compresses at ~400 MB/s
    medium-file-throughput {
        description "Files 64KB to 10MB"
        metric "megabytes_per_second"
        target 250         // 250 MB/s - good parallel VSA + compression
        threshold 150      // 150 MB/s - acceptable
        violation 50       // Below 50 MB/s = needs optimization
        notes "VSA encoding and compression are pipelined"
    }

    // Large files (> 10MB) - kernel, initramfs, disk images
    // Baseline: zstd level 9 ~100 MB/s, io_uring read ~2 GB/s
    large-file-throughput {
        description "Files over 10MB"
        metric "megabytes_per_second"
        target 200         // 200 MB/s sustained
        threshold 100      // 100 MB/s minimum
        violation 30       // Below 30 MB/s = unusable for VM images
        notes "Chunk pipeline: read -> hash -> compress -> store"
    }

    // Complete VM image ingest (typical 2-4GB populated root filesystem)
    vm-image-ingest {
        description "Complete VM filesystem encoding"
        metric "seconds_per_gigabyte"
        target 4.0         // 4 seconds per GB = 250 MB/s
        threshold 8.0      // 8 seconds per GB = 125 MB/s
        violation 20.0     // 20 seconds per GB = too slow for practical use
        notes "Includes all file types, preserves full metadata"
    }
}

// =============================================================================
// SECTION 2: EXTRACT PERFORMANCE
// =============================================================================
// Extract = reading engram + VSA decoding + decompression + writing files
// Critical for VM boot time and disaster recovery

extract-performance {
    // Single file extraction (random access)
    // Baseline: FUSE + ext4 read latency ~1-5ms, network FS ~10-50ms
    single-file-latency {
        description "Time to extract one file from engram"
        metric "milliseconds"
        p50-target 5       // 5ms median - competitive with NFS
        p50-threshold 15   // 15ms median - acceptable for interactive use
        p99-target 20      // 20ms p99 - bounded tail latency
        p99-threshold 50   // 50ms p99 - maximum acceptable
        notes "Includes codebook lookup, VSA decode, decompression"
    }

    // Bulk extraction throughput
    // Should be faster than ingest (decompression > compression)
    bulk-extract-throughput {
        description "Sequential extraction of entire engram"
        metric "megabytes_per_second"
        target 400         // 400 MB/s - zstd decompress + VSA decode
        threshold 200      // 200 MB/s minimum
        violation 50       // Below 50 MB/s = bottleneck somewhere
        notes "Decompression is faster than compression"
    }

    // VM restore time (critical for disaster recovery)
    vm-restore {
        description "Time to extract complete VM filesystem"
        metric "seconds_per_gigabyte"
        target 2.5         // 2.5 sec/GB = 400 MB/s
        threshold 5.0      // 5 sec/GB = 200 MB/s
        violation 15.0     // 15 sec/GB = unacceptable for DR
        notes "Must beat network transfer for offline restore"
    }
}

// =============================================================================
// SECTION 3: COMPRESSION RATIOS
// =============================================================================
// Engram size relative to source data
// VSA adds overhead; compression must compensate

compression-ratios {
    // Text files (configs, scripts, logs)
    // Baseline: gzip ~70% reduction, zstd ~75% reduction
    text-compression {
        description "Text-based files (configs, scripts, logs)"
        metric "ratio"     // compressed_size / original_size
        target 0.20        // 5:1 compression (80% reduction)
        threshold 0.30     // 3.3:1 minimum
        violation 0.50     // 2:1 or worse = compression not working
        notes "LZ4 for low-latency, zstd-19 for archival"
    }

    // Binary files (executables, libraries)
    // Baseline: ELF binaries compress ~40-60% with zstd
    binary-compression {
        description "Compiled binaries and shared libraries"
        metric "ratio"
        target 0.45        // 2.2:1 compression
        threshold 0.60     // 1.7:1 minimum
        violation 0.90     // < 1.1:1 = ineffective
        notes "Stripped binaries compress better"
    }

    // Kernel and boot files
    // Already compressed (bzImage, initramfs.gz), limited further compression
    kernel-compression {
        description "Kernel, modules, initramfs"
        metric "ratio"
        target 0.85        // 1.18:1 (pre-compressed, minimal gain)
        threshold 0.95     // Allow slight expansion for VSA overhead
        violation 1.10     // >10% expansion = problem
        notes "Accept limited gains; focus on dedup instead"
    }

    // Overall VM image compression
    // Mix of all file types
    vm-image-compression {
        description "Complete VM filesystem"
        metric "ratio"
        target 0.40        // 2.5:1 overall compression
        threshold 0.55     // 1.8:1 minimum
        violation 0.80     // <1.25:1 = not worth encoding
        notes "Typical Linux root: 30% binaries, 20% text, 50% other"
    }
}

// =============================================================================
// SECTION 4: MEMORY USAGE
// =============================================================================
// Engram operations should not require excessive RAM

memory-usage {
    // Peak memory during ingest
    // Baseline: rsync uses ~50MB, tar uses ~10MB
    ingest-memory {
        description "Peak memory during VM encoding"
        metric "megabytes_per_gigabyte_source"  // MB RAM per GB data
        target 100         // 100 MB per GB = 4GB for 40GB VM
        threshold 250      // 250 MB per GB = 10GB for 40GB VM
        violation 500      // 500 MB per GB = memory-bound
        notes "Streaming chunks prevents full-memory load"
    }

    // Resident memory for mounted FUSE filesystem
    fuse-resident-memory {
        description "Memory for mounted engram filesystem"
        metric "megabytes_plus_per_gigabyte"  // Base + per-GB
        base 50            // 50 MB base overhead
        per-gb 20          // 20 MB per GB of source data
        threshold-base 100
        threshold-per-gb 50
        notes "Codebook stays in memory; data streamed on demand"
    }

    // Memory for index/query operations
    query-memory {
        description "Memory for similarity queries"
        metric "megabytes"
        target 256         // 256 MB for 100K file index
        threshold 512      // 512 MB acceptable
        violation 2048     // 2 GB = too expensive for query
        notes "Inverted index should be memory-mapped"
    }
}

// =============================================================================
// SECTION 5: CONCURRENT OPERATIONS
// =============================================================================
// Multi-threaded performance scaling

concurrency {
    // Thread scaling efficiency
    // Perfect scaling = 2x threads → 2x throughput
    thread-scaling {
        description "Throughput scaling with thread count"
        metric "scaling_factor"  // actual_speedup / thread_count
        target 0.80        // 80% scaling efficiency (8 threads → 6.4x)
        threshold 0.60     // 60% minimum (8 threads → 4.8x)
        violation 0.40     // <40% = bottleneck
        notes "Lock contention and I/O are primary limiters"
    }

    // Concurrent readers on FUSE mount
    concurrent-readers {
        description "Simultaneous file reads from mounted engram"
        metric "readers_without_degradation"
        target 16          // 16 concurrent readers at full speed
        threshold 8        // 8 readers minimum
        notes "Read-only FUSE allows unlimited parallel reads"
    }
}

// =============================================================================
// SECTION 6: VM BOOT VALIDATION (LOCAL-ONLY)
// =============================================================================
// These tests run ONLY on local workstations, never in CI
// They verify engram-encoded VM images actually boot

vm-boot-local {
    // x86_64 with KVM acceleration
    x86-64-kvm-boot {
        description "Time to boot x86_64 VM from engram (KVM)"
        metric "seconds_to_login_prompt"
        target 3.0         // 3 seconds to login prompt
        threshold 8.0      // 8 seconds maximum
        notes "Uses KVM acceleration; native speed"
        ci false           // LOCAL ONLY
    }

    // aarch64 emulated on x86 host
    aarch64-emulated-boot {
        description "Time to boot ARM64 VM from engram (TCG)"
        metric "seconds_to_login_prompt"
        target 30.0        // 30 seconds (emulation is slow)
        threshold 60.0     // 60 seconds maximum
        notes "TCG emulation ~10-20x slower than native"
        ci false           // LOCAL ONLY
    }

    // RISC-V emulated
    riscv64-emulated-boot {
        description "Time to boot RISC-V VM from engram (TCG)"
        metric "seconds_to_login_prompt"
        target 45.0        // 45 seconds
        threshold 90.0     // 90 seconds maximum
        notes "RISC-V TCG less optimized than ARM"
        ci false           // LOCAL ONLY
    }
}

// =============================================================================
// SECTION 7: DURABILITY & CRASH RECOVERY
// =============================================================================
// Journal and recovery guarantees

durability {
    // Write durability after commit
    commit-durability {
        description "Data survives crash after commit returns"
        metric "boolean"
        requirement true
        notes "Requires fsync or io_uring IORING_FSYNC"
    }

    // Recovery time after crash
    journal-replay {
        description "Time to replay journal on mount"
        metric "milliseconds_per_megabyte_journal"
        target 1.0         // 1ms per MB of journal
        threshold 5.0      // 5ms per MB maximum
        notes "Journal kept small via checkpointing"
    }

    // Maximum data loss window (group commit)
    data-loss-window {
        description "Maximum data loss on crash (group commit mode)"
        metric "milliseconds"
        target 5           // 5ms max data loss
        threshold 50       // 50ms maximum acceptable
        notes "Configurable via DurabilityMode::GroupCommit"
    }
}

// =============================================================================
// SECTION 8: DISK IMAGE ENCODING (NEW)
// =============================================================================
// Performance targets for QCOW2 and raw image encoding

disk-image {
    // QCOW2 read throughput
    qcow2-read-throughput {
        description "Sequential read from QCOW2 image"
        metric "megabytes_per_second"
        target 500         // 500 MB/s with tokio-uring
        threshold 200      // 200 MB/s minimum
        notes "Depends on cluster size and backing files"
    }

    // Raw image read throughput
    raw-read-throughput {
        description "Sequential read from raw image"
        metric "megabytes_per_second"
        target 1500        // 1.5 GB/s (io_uring optimized)
        threshold 500      // 500 MB/s minimum
        notes "Limited only by storage speed"
    }

    // Partition table parsing
    partition-parse {
        description "Time to parse GPT/MBR partition table"
        metric "milliseconds"
        target 1           // 1ms
        threshold 10       // 10ms maximum
        notes "Single disk read + parsing"
    }

    // Filesystem traversal
    ext4-traversal {
        description "ext4 inode traversal rate"
        metric "inodes_per_second"
        target 100000      // 100K inodes/sec
        threshold 30000    // 30K minimum
        notes "Depends on inode distribution and caching"
    }
}
